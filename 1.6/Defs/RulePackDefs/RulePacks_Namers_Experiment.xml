<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<RulePackDef>
		<defName>CR_NamerPersonExperiment</defName>
		<rulePack>
			<rulesStrings>
				<li>r_name->[expieFirstNameFinal] [lastName]</li>

				<li>lastName(p=3)->[lastGenerated]</li>
				<li>lastGenerated->[WordTribal]</li>

				<li>WordTribal(p=3)->[SylG][SylG]</li>
				<li>WordTribal(p=2)->[SylG][SylG][SylG]</li>
				<li>WordTribal->[SylG][SylG][SylG][SylG]</li>

				<li>expieFirstNameFinal(p=8)->[experimentFirstName]</li>
				<li>expieFirstNameFinal->[expieIDNumberHeader][expieIDNumber_rand][expieIDNumber_rand][expieIDNumber_rand]</li>
				
				<!-- Generates a five-six digit number -->
				<li>expieIDNumberHeader->[expieIDNumber_rand]</li>
				<li>expieIDNumberHeader(p=3)->[expieIDNumber_rand][expieIDNumber_rand]</li>
				
				<li>expieIDNumber_rand->0</li>
				<li>expieIDNumber_rand->1</li>
				<li>expieIDNumber_rand->2</li>
				<li>expieIDNumber_rand->3</li>
				<li>expieIDNumber_rand->4</li>
				<li>expieIDNumber_rand->5</li>
				<li>expieIDNumber_rand->6</li>
				<li>expieIDNumber_rand->7</li>
				<li>expieIDNumber_rand->8</li>
				<li>expieIDNumber_rand->9</li>

			</rulesStrings>
			<rulesFiles>
				<li>SylG->WordParts/Syllables_Galician</li>
				<li>experimentFirstName->Names/Experiment_Gunsaw_FirstName</li>
			</rulesFiles>
		</rulePack>
	</RulePackDef>
</Defs>