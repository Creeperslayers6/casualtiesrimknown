<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!-- Sound Cannon Base -->
	<ThingDef ParentName="BuildingBase">
		<defName>CR_Turret_SoundCannonBasic</defName>
		<label>sound cannon turret</label>
		<description>This is a test1</description> <!-- REVIEW!!! -->
		<thingClass>CasualtiesRimknown.Buildings.Building_TurretSonic</thingClass>
		<drawerType>MapMeshAndRealTime</drawerType>
		<drawHighlight>true</drawHighlight>
		<drawHighlightOnlyForHostile>true</drawHighlightOnlyForHostile>
		<graphicData>
			<texPath>Things/Building/Security/TurretMini_Base</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(3,3)</drawSize>
			<damageData>
				<rect>(0.2,0.2,0.6,0.6)</rect>
			</damageData>
			<shadowData>
				<volume>(0.27,0.25,0.27)</volume>
				<offset>(0,0,0)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>CasualtiesRimknown/Things/Building/Security/Sound_Cannon/TurretSoundCannon_MenuIcon</uiIconPath> <!-- REVIEW!!! -->
		<uiIconScale>0.90</uiIconScale> <!-- REVIEW!!! -->
		<minifiedDef>MinifiedThing</minifiedDef>
		<altitudeLayer>Building</altitudeLayer>
		<stealable>false</stealable>
		<rotatable>false</rotatable>
		<thingCategories>
			<li>BuildingsSecurity</li>
		</thingCategories>
		<statBases> <!-- REVIEW!!! -->
			<MaxHitPoints>100</MaxHitPoints>
			<Flammability>0.7</Flammability>
			<WorkToBuild>1800</WorkToBuild>
			<Mass>8</Mass>
			<Beauty>-20</Beauty>
			<ShootingAccuracyTurret>0.96</ShootingAccuracyTurret>
		</statBases> <!-- REVIEW!!! -->
		<tickerType>Normal</tickerType>
		<comps>
			<li Class="CompProperties_Forbiddable"/>
			<li Class="CompProperties_Refuelable"> <!-- REVIEW!!! -->
				<fuelLabel>Shots until barrel change</fuelLabel>
				<fuelGizmoLabel>Barrel durability</fuelGizmoLabel>
				<outOfFuelMessage>Needs new barrel</outOfFuelMessage>
				<fuelFilter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</fuelFilter>
				<fuelCapacity>60</fuelCapacity>
				<!-- 30 bursts -->
				<fuelMultiplier>0.75</fuelMultiplier>
				<!-- 1.333 steel per burst, 80 per full rearm -->
				<initialFuelPercent>1</initialFuelPercent>
				<autoRefuelPercent>0.5</autoRefuelPercent>
				<showFuelGizmo>true</showFuelGizmo>
				<minimumFueledThreshold>1</minimumFueledThreshold>
				<factorByDifficulty>true</factorByDifficulty>
				<consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
				<fuelIconPath>UI/Overlays/Barrel</fuelIconPath>
			</li> <!-- REVIEW!!! -->
			<li Class="CompProperties_Stunnable">
				<affectedDamageDefs>
					<li>Stun</li>
					<li>EMP</li>
				</affectedDamageDefs>
			</li>
		</comps>
		<passability>PassThroughOnly</passability>
		<pathCost>50</pathCost>
		<fillPercent>0.4</fillPercent>
		<hasTooltip>true</hasTooltip>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<costStuffCount>30</costStuffCount> <!-- REVIEW!!! -->
		<costList> <!-- REVIEW!!! -->
			<Steel>70</Steel>
			<ComponentIndustrial>3</ComponentIndustrial>
		</costList> <!-- REVIEW!!! -->
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<designationCategory>Security</designationCategory>
		<constructionSkillPrerequisite>5</constructionSkillPrerequisite> <!-- REVIEW!!! -->
		<building>
			<combatPower>45</combatPower> <!-- same as a scavenger --> <!-- REVIEW!!! -->
			<ai_combatDangerous>true</ai_combatDangerous>
			<turretGunDef>CR_Cannon_SoundTurret</turretGunDef>
			<turretBurstWarmupTime>5</turretBurstWarmupTime>
			<turretBurstCooldownTime>5</turretBurstCooldownTime>
		</building>
		<placeWorkers> <!-- REVIEW!!! -->
			<li>PlaceWorker_TurretTop</li>
			<li>CasualtiesRimknown.PlaceWorkers.PlaceWorker_ShowTurretRadius_ArcShock</li>
		</placeWorkers> <!-- REVIEW!!! -->
		<designationHotKey>Misc2</designationHotKey>
		<researchPrerequisites>
			<li>GunTurrets</li> <!-- REVIEW!!! -->
		</researchPrerequisites>
	</ThingDef>
	
	<!-- Sonic Transducer Def (Sound Cannon Turret Top) -->
	<ThingDef ParentName="BaseWeaponTurret">
		<defName>CR_Cannon_SoundTurret</defName>
		<label>sound cannon transducer</label>
		<description>An array of piezoelectric transducers powered by high-yield capacitors made to be mounted on a turret.</description>
		<graphicData>
			<texPath>CasualtiesRimknown/Things/Building/Security/Sound_Cannon/TurretSoundCannon_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<AccuracyTouch>1</AccuracyTouch>
			<AccuracyShort>1</AccuracyShort>
			<AccuracyMedium>1</AccuracyMedium>
			<AccuracyLong>1</AccuracyLong>
			<RangedWeapon_Cooldown>8</RangedWeapon_Cooldown>
			<DeteriorationRate>0</DeteriorationRate>
			<Mass>5</Mass>
			<Flammability>0</Flammability>
		</statBases>
		<verbs>
			<li>
				<verbClass>CasualtiesRimknown.Verbs.Verb_ArcShockwave</verbClass>
				<range>30</range>
				<consumeFuelPerShot>1</consumeFuelPerShot>
			</li>
		</verbs>
	</ThingDef>
</Defs>