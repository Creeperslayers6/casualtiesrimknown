	<!--| Trauma Rig |-->
	<ThingDef ParentName="ArmorMachineableBase">
		<defName>CR_Apparel_TraumaRig</defName>
		<label>trauma rig</label>
		<description>TODO: WRITE DESCRIPTION!!!</description>
		<graphicData>
			<texPath>CasualtiesRimknown/Things/Pawn/Humanlike/Apparel/TraumaRig/TraumaRig</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<costList>
			<Neutroamine>1</Neutroamine>
		</costList>
		<thingCategories>
			<li>ApparelArmor</li>
		</thingCategories>
		<statBases>
			<WorkToMake>75000</WorkToMake>
			<MaxHitPoints>400</MaxHitPoints>
			<Mass>15</Mass>
			<Flammability>0.4</Flammability>
			<ArmorRating_Sharp>1.2</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.5</ArmorRating_Blunt>
			<ArmorRating_Heat>0.6</ArmorRating_Heat>
			<Insulation_Cold>70</Insulation_Cold>
			<Insulation_Heat>12</Insulation_Heat>
			<EquipDelay>17</EquipDelay>
		</statBases>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
			</bodyPartGroups>
			<wornGraphicPath>CasualtiesRimknown/Things/Pawn/Humanlike/Apparel/TraumaRig/TraumaRig</wornGraphicPath>
			<layers>
				<li>Middle</li>
				<li>Shell</li>
			</layers>
			<defaultOutfitTags>
				<li>Soldier</li>
			</defaultOutfitTags>
		</apparel>
		<colorGenerator Class="ColorGenerator_Options">
			<options>
				<li>
					<weight>10</weight>
					<only>(0.9,0.9,0.9)</only>
				</li>
				<li>
					<weight>10</weight>
					<only>(0.33,0.33,0.33)</only>
				</li>
				<li>
					<weight>10</weight>
					<only>(0.65,0.65,0.65)</only>
				</li>
				<li>
					<weight>6</weight>
					<min>(0.3,0.3,0.3)</min>
					<max>(0.5,0.5,0.5)</max>
				</li>
			</options>
		</colorGenerator>
		<tradeTags>
			<li>Armor</li>
		</tradeTags>
	</ThingDef>

