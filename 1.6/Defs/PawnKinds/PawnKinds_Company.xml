		<label>untrained troop</label>
		<gearHealthRange>0.8~3</gearHealthRange>
		<apparelTags>
			<li>IndustrialMilitaryBasic</li>
		</apparelTags>
		<apparelMoney>400~600</apparelMoney>
		<apparelAllowHeadgearChance>0.4</apparelAllowHeadgearChance>
		<weaponTags>
			<li>Gun</li>
		</weaponTags>
		<weaponMoney>250~400</weaponMoney>
		<techHediffsChance>0.04</techHediffsChance>
		<techHediffsMoney>200~700</techHediffsMoney>
		<techHediffsTags>
			<li>Poor</li>
			<li>Simple</li>
			<li>ImplantEmpireCommon</li>
		</techHediffsTags>
		<initialWillRange>0~3</initialWillRange>
		<initialResistanceRange>10~18</initialResistanceRange>
		<combatEnhancingDrugsChance>0.10</combatEnhancingDrugsChance>
		<combatEnhancingDrugsCount>0~2</combatEnhancingDrugsCount>
	</PawnKindDef>

	<PawnKindDef ParentName="CR_CorpUntrainedTroop">
		<defName>CR_CorporateUntrainedTroopChipped</defName>
