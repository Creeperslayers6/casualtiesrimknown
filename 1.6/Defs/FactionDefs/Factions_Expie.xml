<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<FactionDef ParentName="FactionBase" Name="CR_SawianOutlanderFactionBase" Abstract="True">
		<pawnSingular>sawian</pawnSingular>
		<pawnsPlural>sawians</pawnsPlural>
		<categoryTag>CR_SawianOutlander</categoryTag>
		<listOrderPriority>10</listOrderPriority>
		<settlementGenerationWeight>0.5</settlementGenerationWeight>
		<requiredCountAtGameStart>1</requiredCountAtGameStart>
		<canSiege>true</canSiege>
		<canStageAttacks>true</canStageAttacks>
		<leaderTitle>elder</leaderTitle> <!-- REVIEW -->
		<factionIconPath>World/WorldObjects/Expanding/Town</factionIconPath> <!-- REVIEW -->
		<techLevel>Industrial</techLevel>
		<factionNameMaker>NamerFactionOutlander</factionNameMaker> <!-- REVIEW -->
		<settlementNameMaker>NamerSettlementOutlander</settlementNameMaker>
		<allowedCultures>
			<li>Rustican</li> <!-- REVIEW -->
		</allowedCultures>
		<disallowedMemes>
			<li MayRequire="Ludeon.RimWorld.Ideology">Structure_Animist</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Nudism</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Blindsight</li>
		</disallowedMemes>
		<structureMemeWeights> <!-- REVIEW -->
			<Structure_TheistEmbodied MayRequire="Ludeon.RimWorld.Ideology">1</Structure_TheistEmbodied>
			<Structure_TheistAbstract MayRequire="Ludeon.RimWorld.Ideology">2</Structure_TheistAbstract>
			<Structure_Ideological MayRequire="Ludeon.RimWorld.Ideology">1</Structure_Ideological>
			<Structure_Archist MayRequire="Ludeon.RimWorld.Ideology">1</Structure_Archist>
			<Structure_OriginChristian MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginChristian>
			<Structure_OriginIslamic MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginIslamic>
			<Structure_OriginHindu MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginHindu>
			<Structure_OriginBuddhist MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginBuddhist>
		</structureMemeWeights> <!-- REVIEW -->
		<xenotypeSet>
			<xenotypeChances>
				<ERN_Expie>999</ERN_Expie>
			</xenotypeChances>
		</xenotypeSet>
		<backstoryFilters>
			<li>
				<categories>
					<li>CR_ExpieGreyPlanet</li> <!-- REVIEW!!!! - Should be standard unchipped expie backstory -->
					<li>CR_ExpieChildCompany</li>
				</categories>
				<commonality>0.95</commonality>
			</li>
			<li>
				<categories>
					<li>CR_ExpieCompany</li> <!-- REVIEW!!!! - Should be The Company's Expie Soldiers-->
					<li>CR_ExpieChildCompany</li>
				</categories>
				<commonality>0.05</commonality>
			</li>
		</backstoryFilters>
		<caravanTraderKinds> <!-- REVIEW!!! -->
			<li>Caravan_Outlander_BulkGoods</li>
			<li>Caravan_Outlander_CombatSupplier</li>
			<li>Caravan_Outlander_Exotic</li>
			<li>Caravan_Outlander_PirateMerchant</li>
		</caravanTraderKinds> <!-- REVIEW -->
		<visitorTraderKinds> <!-- REVIEW -->
			<li>Visitor_Outlander_Standard</li>
		</visitorTraderKinds> <!-- REVIEW -->
		<baseTraderKinds> <!-- REVIEW -->
			<li>Base_Outlander_Standard</li>
		</baseTraderKinds> <!-- REVIEW -->
		<allowedArrivalTemperatureRange>-40~45</allowedArrivalTemperatureRange>
		<raidLootMaker>OutlanderRaidLootMaker</raidLootMaker> <!-- REVIEW -->
		<maxPawnCostPerTotalPointsCurve>
			<points>
				<li>(0,35)</li>
				<li>(70, 50)</li>
				<li>(700, 100)</li>
				<li>(1300, 150)</li>
				<li>(100000, 10000)</li>
			</points>
		</maxPawnCostPerTotalPointsCurve>
		<pawnGroupMakers> <!-- REVIEW -->
			<li>
				<!-- Normal fights, standard mix -->
				<kindDef>Combat</kindDef>
				<options>
					<Villager>5</Villager>
					<Town_Guard>10</Town_Guard>
					<Grenadier_Destructive>1.5</Grenadier_Destructive>
					<Mercenary_Slasher>7</Mercenary_Slasher>
					<Mercenary_Gunner>10</Mercenary_Gunner>
					<Mercenary_Elite>10</Mercenary_Elite>
					<Town_Councilman>10</Town_Councilman>
				</options>
			</li>
			<li>
				<kindDef>Peaceful</kindDef>
				<options>
					<Villager>20</Villager>
					<Villager_Child MayRequire="Ludeon.RimWorld.Biotech">10</Villager_Child>
					<Town_Guard>10</Town_Guard>
					<Town_Councilman>10</Town_Councilman>
				</options>
			</li>
			<li>
				<kindDef>Trader</kindDef>
				<traders>
					<Town_Trader>1</Town_Trader>
				</traders>
				<carriers>
					<Muffalo>6</Muffalo>
					<Dromedary>5</Dromedary>
					<Alpaca>2</Alpaca>
					<Elephant>1</Elephant>
				</carriers>
				<guards>
					<Villager>3</Villager>
					<Town_Guard>10</Town_Guard>
					<Grenadier_Destructive>1.5</Grenadier_Destructive>
					<Mercenary_Slasher>7</Mercenary_Slasher>
					<Mercenary_Gunner>10</Mercenary_Gunner>
					<Mercenary_Elite>10</Mercenary_Elite>
				</guards>
			</li>
			<li>
				<kindDef>Settlement</kindDef>
				<options>
					<Villager>10</Villager>
					<Town_Guard>10</Town_Guard>
					<Grenadier_Destructive>1.5</Grenadier_Destructive>
					<Mercenary_Slasher>7</Mercenary_Slasher>
					<Mercenary_Gunner>10</Mercenary_Gunner>
					<Mercenary_Elite>10</Mercenary_Elite>
					<Town_Councilman>10</Town_Councilman>
				</options>
			</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">
				<kindDef>Miners</kindDef>
				<commonality>1</commonality>
				<options>
					<Miner>1</Miner>
				</options>
			</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">
				<kindDef>Hunters</kindDef>
				<commonality>1</commonality>
				<options>
					<Hunter>1</Hunter>
				</options>
			</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">
				<kindDef>Loggers</kindDef>
				<commonality>1</commonality>
				<options>
					<Logger>1</Logger>
				</options>
			</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">
				<kindDef>Farmers</kindDef>
				<commonality>1</commonality>
				<options>
					<Farmer>1</Farmer>
				</options>
			</li>
		</pawnGroupMakers> <!-- REVIEW -->
		<settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
	</FactionDef>

	<FactionDef ParentName="CR_SawianOutlanderFactionBase">
		<defName>CR_SawianOutlanderCivil</defName>
		<label>civil sawian settlements</label>
		<description>These unchipped sawians have settled here for a few decades after escaping the Grey Planet./n/n FINISH THIS DESCRIPTION!!!! This particular group is accepting of other civil groups.</description>
		<colorSpectrum>
			<li>(0.50, 0.30, 0.50)</li>
			<li>(0.60, 0.40, 0.90)</li>
		</colorSpectrum>
		<classicIdeo>true</classicIdeo>
		<maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
		<configurationListOrderPriority>5</configurationListOrderPriority>
	</FactionDef>

	<FactionDef ParentName="CR_SawianOutlanderFactionBase">
		<defName>CR_SawianOutlanderRough</defName>
		<label>rough sawian settlements</label>
		<description>These unchipped sawians have settled here for a few years or a couple decades after escaping the Grey Planet./n/n FINISH THIS DESCRIPTION!!!! This particular group is traumatized by their treatment from The Company and is hostile with outsiders.</description>
		<colorSpectrum>
			<li>(0.50, 0.10, 0.30)</li>
			<li>(0.90, 0.40, 0.60)</li>
		</colorSpectrum>
		<classicIdeo>true</classicIdeo>
		<naturalEnemy>true</naturalEnemy>
		<hostileToFactionlessHumanlikes>true</hostileToFactionlessHumanlikes>
		<maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
		<configurationListOrderPriority>6</configurationListOrderPriority>
	</FactionDef>
</Defs>