<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!-- THE COMPANY FACTION | HOSTILE -->
	<FactionDef ParentName="FactionBase">
		<defName>CR_TheCompany</defName>
		<label>a spacer corporation</label>
		<fixedName>The Company™</fixedName>
		<categoryTag>CR_TheCompany</categoryTag>
		<description>A large conglomerate based in a distant glitterworld which produces a variety of goods such as technology and advanced medicine.\n\nIt isn't clear why The Company is involving itself with this Rimworld, but many suspect it could be linked to the new furry Xenotypes that arrived a while ago. However, colonies that accept these Xenotypes or try to look into this company tend to fall into ruin.</description>
		<pawnSingular>expendable</pawnSingular>
		<pawnsPlural>expendables</pawnsPlural>
		<settlementGenerationWeight>0.15</settlementGenerationWeight>
		<requiredCountAtGameStart>1</requiredCountAtGameStart>
		<canSiege>true</canSiege>
		<canStageAttacks>true</canStageAttacks>
		<leaderTitle>captain</leaderTitle>
		<factionIconPath>CasualtiesRimknown/World/WorldObjects/Expanding/MapIcon_Company</factionIconPath>
		<techLevel>Spacer</techLevel>
		<factionNameMaker>NamerFactionOutlander</factionNameMaker>
		<settlementNameMaker>CR_NamerSettlementCompany</settlementNameMaker>
		<allowedCultures>
			<li>CR_Corpoloyalty</li>
		</allowedCultures>
		<arrivalLayerWhitelist>
			<li>Surface</li>
			<li MayRequire="Ludeon.Rimworld.Odyssey">Orbit</li>
		</arrivalLayerWhitelist>
		<!-- ========== -->
		<fixedIdeo>true</fixedIdeo>
		<ideoName>Corpoloyalty</ideoName>
		<ideoDescription>The broadcast from &lt;color=#D09B61FF&gt;The CEO&lt;/color&gt; was clear. The Company™ was and will always be a meritocracy where performance equals reward. Sawians who are able to clear out the  unchipped planets on the RimWorld and recover &lt;color=#D09B61FF&gt;The Cargo&lt;/color&gt;.</ideoDescription>
		<deityPresets>
			<li>
				<nameType>
					<name>The CEO</name>
					<type>CEO of The Company™</type>
				</nameType>
				<gender>Male</gender>
				<iconPath>UI/Deities/DeityGeneric</iconPath>
			</li>
		</deityPresets>
		<styles>
			<li MayRequire="Ludeon.RimWorld.Ideology">CR_Corpoloyalty</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Techist</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Christian</li>
		</styles>
		<forcedMemes>
			<li MayRequire="Ludeon.RimWorld.Ideology">Structure_TheistAbstract</li>
			<li MayRequire="Ludeon.Rimworld.Ideology">HumanPrimacy</li>
			<li MayRequire="Ludeon.Rimworld.Ideology">Loyalist</li>
		</forcedMemes>
		<disallowedPrecepts>
			<li>Slavery_Classic</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Slavery_Disapproved</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Slavery_Horrible</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Slavery_Abhorrent</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">IdeoDiversity_Respected</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">IdeoDiversity_Exalted</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Nudity_Male_CoveringAnythingButGroinDisapproved</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Nudity_Female_CoveringAnythingButGroinDisapproved</li>
		</disallowedPrecepts>
		<backstoryFilters>
			<li>
				<categories>
					<li>CR_ExpieCompany</li>
					<li>CR_ExpieChildCompany</li>
				</categories>
			</li>
		</backstoryFilters>
		<xenotypeSet>
			<xenotypeChances>
				<ERN_Expie>999</ERN_Expie>
			</xenotypeChances>
		</xenotypeSet>
		<permanentEnemyToEveryoneExcept>
			<li>OutlanderCivil</li>
			<li>TribeCivil</li>
			<li>PlayerTribe</li>
			<li>PlayerColony</li>
			<li>Ancients</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Beggars</li>
			<li MayRequire="Ludeon.RimWorld.Anomaly">ResearchExpedition</li>
			<li MayRequire="Ludeon.RimWorld.Odyssey">GravshipCrew</li>
			<li MayRequire="Ludeon.RimWorld.Odyssey">TradersGuild</li>
		</permanentEnemyToEveryoneExcept>
		<apparelStuffFilter>
			<stuffCategoriesToAllow>
				<li>Metallic</li>
				<li>Fabric</li>
			</stuffCategoriesToAllow>
			<disallowedThingDefs>
				<li>DevilstrandCloth</li>
			</disallowedThingDefs>
		</apparelStuffFilter>
		<allowedArrivalTemperatureRange>-40~45</allowedArrivalTemperatureRange>
		<settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
		<colorSpectrum>
			<li>(0.85, 0.34, 0.49)</li>
		</colorSpectrum>
		<raidCommonalityFromPointsCurve>
			<points>
				<li>(0, 1)</li> <!--Constant 1 at all points levels-->
			</points>
		</raidCommonalityFromPointsCurve>
		<raidLootMaker>CR_CompanyRaidLootMaker</raidLootMaker>
		<maxPawnCostPerTotalPointsCurve>
			<points>
				<li>(0,80)</li>
				<li>(600,100)</li>
				<li>1800,300)</li>
				<li>(5000,1000)</li>
				<li>(18000,7500)</li>
				<li>(20000,10000)</li>
			</points>
		</maxPawnCostPerTotalPointsCurve>
		<pawnGroupMakers>
			<li>
				<!-- Normal fights -->
				<kindDef>Combat</kindDef>
				<commonality>100</commonality>
				<options>
					<CR_CorporateFodderChipped>9</CR_CorporateFodderChipped>
					<CR_CorporateFodder>1</CR_CorporateFodder>
					<CR_CorporateGruntChipped>9</CR_CorporateGruntChipped>
					<CR_CorporateGrunt>1</CR_CorporateGrunt>
					<CR_CorporateSoldierChipped>18</CR_CorporateSoldierChipped>
					<CR_CorporateSoldier>2</CR_CorporateSoldier>
					<CR_CorporateBreacherChipped>4</CR_CorporateBreacherChipped>
					<CR_CorporateBreacher>1</CR_CorporateBreacher>
					<CR_CorporateMarksmanChipped>3</CR_CorporateMarksmanChipped>
					<CR_CorporateMarksman>1</CR_CorporateMarksman>
					<CR_SeniorCorporateSoldierChipped>2</CR_SeniorCorporateSoldierChipped>
				</options>
			</li>
			<li>
				<!-- breach fights -->
				<kindDef>Combat</kindDef>
				<commonality>10</commonality>
				<options>
					<CR_CorporateFodderChipped>9</CR_CorporateFodderChipped>
					<CR_CorporateFodder>1</CR_CorporateFodder>
					<CR_CorporateGruntChipped>9</CR_CorporateGruntChipped>
					<CR_CorporateGrunt>1</CR_CorporateGrunt>
					<CR_CorporateSoldierChipped>18</CR_CorporateSoldierChipped>
					<CR_CorporateSoldier>2</CR_CorporateSoldier>
					<CR_CorporateBreacherChipped>4</CR_CorporateBreacherChipped>
					<CR_CorporateBreacher>1</CR_CorporateBreacher>
					<CR_CorporateGrenadierChipped>4</CR_CorporateGrenadierChipped>
					<CR_CorporateGrenadier>1</CR_CorporateGrenadier>
					<CR_SeniorCorporateSoldierChipped>2</CR_SeniorCorporateSoldierChipped>
				</options>
			</li>
			<li>
				<!-- Base defense, mainly ranged with melee mix-ins -->
				<kindDef>Settlement</kindDef>
				<options>
					<CR_CorporateFodderChipped>9</CR_CorporateFodderChipped>
					<CR_CorporateFodder>1</CR_CorporateFodder>
					<CR_CorporateGruntChipped>9</CR_CorporateGruntChipped>
					<CR_CorporateGrunt>1</CR_CorporateGrunt>
					<CR_CorporateSoldierChipped>9</CR_CorporateSoldierChipped>
					<CR_CorporateSoldier>1</CR_CorporateSoldier>
				</options>
			</li>
		</pawnGroupMakers>
		<maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
		<configurationListOrderPriority>75</configurationListOrderPriority>
		<disallowedRaidAgeRestrictions>
			<li MayRequire="Ludeon.RimWorld.Biotech">Children</li>
		</disallowedRaidAgeRestrictions>
		<canRequestTraders>false</canRequestTraders>
		<canGenerateQuestSites>false</canGenerateQuestSites>
	</FactionDef>
	
	<!-- ========= RaidLootMaker =========-->

	<ThingSetMakerDef>
		<defName>CR_CompanyRaidLootMaker</defName>
		<root Class="ThingSetMaker_MarketValue">
			<fixedParams>
				<filter>
					<thingDefs>
						<li>Silver</li>
						<li>MedicineIndustrial</li>
						<li>MealSurvivalPack</li>
						<li>Neutroamine</li>
						<li>CR_Braingrow</li>
						<li>CR_Mindwipe</li>
						<li>Pemmican</li>
					</thingDefs>
				</filter>
			</fixedParams>
		</root>
	</ThingSetMakerDef>
	
	<!-- ========= Names ========== -->
	<RulePackDef>
		<defName>CR_NamerSettlementCompany</defName>
		<rulePack>
			<rulesStrings>
				<li>r_name(p=12)->[townname_wordgen]</li>
				<li>r_name(p=6)->[townname_fixed]</li>
				<li>r_name(p=4)->[townname_combo]</li>
				<li>r_name->[townname_near]</li>

				<li>topicalnoun->[Game]</li>
				<li>topicalnoun->[BodyPart]</li>

				<li>townname_combo->[topicalnoun] [TerrainFeature]</li>
				<li>townname_combo->[topicalnoun] [Community]</li>
				<li>townname_combo->[topicalnoun]'s [TerrainFeature]</li>
				<li>townname_combo->[topicalnoun]'s [Community]</li>
				<li>townname_combo(p=2)->[concept_positive]'s [TerrainFeature]</li>
				<li>townname_combo(p=2)->[concept_positive] [TerrainFeature]</li>
				<li>townname_combo(p=2)->[concept_positive] [Community]</li>

				<li>townname_near->[nearnameinitial]-at-the-[TerrainFeature]</li>
				<li>townname_near->[nearnameinitial]-by-the-[TerrainFeature]</li>
				<li>townname_near->[nearnameinitial]-on-the-[TerrainFeature]</li>
				<li>nearnameinitial->[townname_wordgen]</li>
				<li>nearnameinitial->[Community]</li>

				<li>townname_wordgen(p=2)->[SylE][SylE]</li>
				<li>townname_wordgen(p=2)->[SylE][SylE][SylE]</li>
				<li>townname_wordgen(p=2)->[SylE][townend]</li>
				<li>townname_wordgen(p=2)->[SylE][SylE][townend]</li>
				<li>townname_wordgen->[TerrainFeature][townend]</li>
				<li>townname_wordgen->[topicalnoun][townend]</li>
				<li>townend->ville</li>
				<li>townend->town</li>
				<li>townend->hurst</li>
				<li>townend->bourne</li>
				<li>townend->brad</li>
				<li>townend->dale</li>
				<li>townend->hope</li>
				<li>townend->ing</li>
				<li>townend->ness</li>
				<li>townend->mere</li>
				<li>townend->shaw</li>
				<li>townend->wick</li>
				<li>townend->ton</li>
				<li>townend->ston</li>
				<li>townend->os</li>
				<li>townend->den</li>
				<li>townend->tas</li>
				<li>townend->wood</li>
				<li>townend->land</li>
				<li>townend->worth</li>
				<li>townend->roon</li>
				<li>townend->ron</li>
				<li>townend->well</li>
			</rulesStrings>
			<rulesFiles>
				<li>townname_fixed->Names/OutlanderTown</li>
				<li>concept_positive->Words/Nouns/Concepts_Positive</li>
			</rulesFiles>
		</rulePack>
	</RulePackDef>
</Defs>