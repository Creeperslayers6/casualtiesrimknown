<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<FactionDef ParentName="PlayerFactionBase">
		<defName>CR_PlayerExpieColony</defName>
		<label>New Escapees</label>
		<description>A colony of recently-escaped sawians from the Grey Planet.</description>
		<isPlayer>true</isPlayer>
		<basicMemberKind>Colonist</basicMemberKind>
		<pawnSingular>colonist</pawnSingular>
		<pawnsPlural>colonists</pawnsPlural>
		<techLevel>Industrial</techLevel>
		<factionNameMaker>NamerFactionOutlander</factionNameMaker>
		<settlementNameMaker>NamerSettlementOutlander</settlementNameMaker>
		<allowedCultures><li>CR_Liathian</li></allowedCultures>
		<xenotypeSet>
			<xenotypeChances>
				<!-- Species: Experiment -->
				<ERN_Expie MayRequire="Erin.Expie">6</ERN_Expie>
				<Expie_Xenotype MayRequire="Expieworld.Package">6</Expie_Xenotype>
				<!-- Species: Milky -->
				<Milky_Xenotype MayRequire="Milkyworld.Package">3</Milky_Xenotype>
				<ERNLE_Milky MayRequire="kotovaann.ernloreexpansion">3</ERNLE_Milky>
				<!-- Species: Dune -->
				<ERNLE_Dune MayRequire="kotovaann.ernloreexpansion">1</ERNLE_Dune>
			</xenotypeChances>
		</xenotypeSet>
		<backstoryFilters>
			<li>
				<categories>
					<li>CR_ExpieGreyPlanet</li>
					<li>CR_ExpieChildCompany</li>
				</categories>
			</li>
		</backstoryFilters>
		<factionIconPath>CasualtiesRimknown/World/WorldObjects/Expanding/MapIcon_Sawian</factionIconPath>
		<forageabilityFactor>1.5</forageabilityFactor> <!-- Time spent on the Grey Planet taught them well. -->
		<startingResearchTags>
			<li>ClassicStart</li>
		</startingResearchTags>
		<startingTechprintsResearchTags>
			<li>ClassicStart</li>
			<li>ClassicStartTechprints</li>
		</startingTechprintsResearchTags>
		<apparelStuffFilter>
			<thingDefs>
				<li>Cloth</li>
			</thingDefs>
		</apparelStuffFilter>
	</FactionDef>
</Defs>