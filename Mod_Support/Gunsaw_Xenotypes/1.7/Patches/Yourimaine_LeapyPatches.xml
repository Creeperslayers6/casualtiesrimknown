<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!-- Last Stand Gene Injection -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/XenotypeDef[defName="Leapy_Xenotype"]/genes</xpath>
		<value>
			<li>CR_LastStand</li>
		</value>
	</Operation>

	<!-- Lore Accurate Leapy Name Injection -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/XenotypeDef[defName="Leapy_Xenotype"]</xpath>
		<value>
			<nameMaker>CR_NamerPersonLeapy</nameMaker>
			<chanceToUseNameMaker>1</chanceToUseNameMaker>
		</value>
	</Operation>
</Patch>