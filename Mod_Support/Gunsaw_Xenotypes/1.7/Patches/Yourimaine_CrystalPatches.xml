<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!-- Last Stand Gene Injection -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/XenotypeDef[defName="Crystal_Xenotype"]/genes</xpath>
		<value>
			<li>CR_LastStand</li>
		</value>
	</Operation>

	<!-- Lore Accurate Crystal Name Injection -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/XenotypeDef[defName="Crystal_Xenotype"]</xpath>
		<value>
			<nameMaker>CR_NamerPersonCrystalTrans</nameMaker>
			<nameMakerFemale>CR_NamerPersonCrystal</nameMakerFemale>
			<chanceToUseNameMaker>1</chanceToUseNameMaker>
		</value>
	</Operation>
</Patch>