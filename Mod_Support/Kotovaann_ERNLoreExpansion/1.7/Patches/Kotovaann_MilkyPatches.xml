<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!-- Last Stand Gene Injection -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/XenotypeDef[defName="ERNLE_Milky"]/genes</xpath>
		<value>
			<li>CR_LastStand</li>
		</value>
	</Operation>
	
	<!-- Lore Accurate Milky Name Injection -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/XenotypeDef[defName="ERNLE_Milky"]</xpath>
		<value>
			<nameMaker>CR_NamerPersonMilky</nameMaker>
			<chanceToUseNameMaker>1</chanceToUseNameMaker>
		</value>
	</Operation>
</Patch>