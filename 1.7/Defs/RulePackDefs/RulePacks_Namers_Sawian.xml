<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!-- Generic Sawian Serial Number -->
	<RulePackDef>
		<defName>CR_NamerPersonSawianGeneric</defName>
		<rulePack>
			<rulesStrings>
				<li>sawianSerialNumber_Final->[expieIDNumberHeader][expieIDNumber_rand][expieIDNumber_rand][expieIDNumber_rand][expieIDNumber_rand]</li>
				<!-- Generates a five-six digit number -->
				<li>expieIDNumberHeader(p=3)->[expieIDNumberLeadValue][expieIDNumber_rand]</li>
				<li>expieIDNumberHeader->[expieIDNumber_randNonZero]</li>
				
				<li>expieIDNumberLeadValue->1</li>
				<li>expieIDNumberLeadValue->2</li>

				<li>expieIDNumber_randNonZero->1</li>
				<li>expieIDNumber_randNonZero->2</li>
				<li>expieIDNumber_randNonZero->3</li>
				<li>expieIDNumber_randNonZero->4</li>
				<li>expieIDNumber_randNonZero->5</li>
				<li>expieIDNumber_randNonZero->6</li>
				<li>expieIDNumber_randNonZero->7</li>
				<li>expieIDNumber_randNonZero->8</li>
				<li>expieIDNumber_randNonZero->9</li>

				<li>expieIDNumber_rand->0</li>
				<li>expieIDNumber_rand->1</li>
				<li>expieIDNumber_rand->2</li>
				<li>expieIDNumber_rand->3</li>
				<li>expieIDNumber_rand->4</li>
				<li>expieIDNumber_rand->5</li>
				<li>expieIDNumber_rand->6</li>
				<li>expieIDNumber_rand->7</li>
				<li>expieIDNumber_rand->8</li>
				<li>expieIDNumber_rand->9</li>

				<!-- Sawian Last Name, I have no reference for any last name so I'm defaulting to a Tribal Last Name. -->
				<li>lastName(p=3)->[lastGenerated]</li>
				<li>lastGenerated->[WordTribal]</li>

				<li>WordTribal(p=3)->[SylG][SylG]</li>
				<li>WordTribal(p=2)->[SylG][SylG][SylG]</li>
				<li>WordTribal->[SylG][SylG][SylG][SylG]</li>
			</rulesStrings>
			<rulesFiles>
				<li>SylG->WordParts/Syllables_Galician</li>
			</rulesFiles>
		</rulePack>
	</RulePackDef>
	
	<!-- Species: Experiment -->
	<RulePackDef>
		<defName>CR_NamerPersonExperiment</defName>
		<include>
			<li>CR_NamerPersonSawianGeneric</li>
		</include>
		<rulePack>
			<rulesStrings>
				<li>r_name->[expieFirstNameFinal] [lastName]</li>

				<li>expieFirstNameFinal(p=8)->[databaseFirstName]</li>
				<li>expieFirstNameFinal->[sawianSerialNumber_Final]</li>
			</rulesStrings>
			<rulesFiles>
				<li>databaseFirstName->Names/Experiment_Gunsaw_FirstName</li>
			</rulesFiles>
		</rulePack>
	</RulePackDef>

