<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<FactionDef ParentName="PlayerFactionBase">
		<defName>CR_PlayerExpieColony</defName>
		<label>New Escapees</label>
		<description>A colony of recently-escaped sawians from the Grey Planet.</description>
		<isPlayer>true</isPlayer>
		<basicMemberKind>Colonist</basicMemberKind>
		<pawnSingular>colonist</pawnSingular>
		<pawnsPlural>colonists</pawnsPlural>
		<techLevel>Industrial</techLevel>
		<factionNameMaker>NamerFactionOutlander</factionNameMaker>
		<settlementNameMaker>NamerSettlementOutlander</settlementNameMaker>
		<allowedCultures><li>CR_Liathian</li></allowedCultures>
		<xenotypeSet>
			<xenotypeChances>
				<!-- Species: Experiment -->
				<ERN_Expie MayRequire="Erin.Expie">360</ERN_Expie>
				<Expie_Xenotype MayRequire="Expieworld.Package">360</Expie_Xenotype>
				<GX_Expie_Xenotype MayRequire="yourimaine.GunsawXenotypes">360</GX_Expie_Xenotype>
				<!-- Species: Milky -->
				<Milky_Xenotype MayRequire="Milkyworld.Package">128</Milky_Xenotype>
				<ERNLE_Milky MayRequire="kotovaann.ernloreexpansion">128</ERNLE_Milky>
				<GX_Milky_Xenotype MayRequire="yourimaine.GunsawXenotypes">128</GX_Milky_Xenotype>
				<!-- Species: Dune -->
				<ERNLE_Dune MayRequire="kotovaann.ernloreexpansion">8</ERNLE_Dune>
				<GX_Dune_Xenotype MayRequire="yourimaine.GunsawXenotypes">8</GX_Dune_Xenotype>
				<!-- Species: Roza -->
				<GX_Roza_Xenotype MayRequire="yourimaine.GunsawXenotypes">32</GX_Roza_Xenotype>
				<!-- Species: Orange -->
				<GX_Orange_Xenotype MayRequire="yourimaine.GunsawXenotypes">208</GX_Orange_Xenotype>
				<!-- Species: Shelly -->
				<GX_Shelly_Xenotype MayRequire="yourimaine.GunsawXenotypes">4</GX_Shelly_Xenotype>
				<!-- Species: Voyager -->
				<GX_Voyager_Xenotype MayRequire="yourimaine.GunsawXenotypes">16</GX_Voyager_Xenotype>
				<!-- Species: Leapy -->
				<GX_Leapy_Xenotype MayRequire="yourimaine.GunsawXenotypes">8</GX_Leapy_Xenotype>
				<!-- Species: Chompy -->
				<GX_Chompy_Xenotype MayRequire="yourimaine.GunsawXenotypes">24</GX_Chompy_Xenotype>
				<!-- Species: Baron -->
				<GX_Baron_Xenotype MayRequire="yourimaine.GunsawXenotypes">1</GX_Baron_Xenotype>
				<!-- Species: Velvet -->
				<GX_Velvet_Xenotype MayRequire="yourimaine.GunsawXenotypes">2</GX_Velvet_Xenotype>
				<!-- Species: Crystal -->
				<GX_Crystal_Xenotype MayRequire="yourimaine.GunsawXenotypes">8</GX_Crystal_Xenotype>
				<!-- Species: Chik -->
				<GX_Chik_Xenotype MayRequire="yourimaine.GunsawXenotypes">16</GX_Chik_Xenotype>
				<!-- Species: Icke -->
				<GX_Icke_Xenotype MayRequire="yourimaine.GunsawXenotypes">4</GX_Icke_Xenotype>
				<!-- Species: Experiment (Albino) -->
				<GX_Albino_Xenotype MayRequire="yourimaine.GunsawXenotypes">4</GX_Albino_Xenotype>
			</xenotypeChances>
		</xenotypeSet>
		<backstoryFilters>
			<li>
				<categories>
					<li>CR_ExpieGreyPlanet</li>
					<li>CR_ExpieChildCompany</li>
				</categories>
			</li>
		</backstoryFilters>
		<factionIconPath>CasualtiesRimknown/World/WorldObjects/Expanding/MapIcon_Sawian</factionIconPath>
		<forageabilityFactor>1.5</forageabilityFactor> <!-- Time spent on the Grey Planet taught them well. -->
		<startingResearchTags>
			<li>ClassicStart</li>
		</startingResearchTags>
		<startingTechprintsResearchTags>
			<li>ClassicStart</li>
			<li>ClassicStartTechprints</li>
		</startingTechprintsResearchTags>
		<apparelStuffFilter>
			<thingDefs>
				<li>Cloth</li>
			</thingDefs>
		</apparelStuffFilter>
	</FactionDef>
</Defs>