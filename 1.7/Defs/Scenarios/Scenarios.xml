<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<ScenarioDef ParentName="ScenarioBase">
		<defName>CR_ExtractionPodInsertion</defName>
		<label>Extraction Pod Insertion</label>
		<description>The modified extraction pod was where the contact said it would be. You and your two fellow sawians enter as the pod burns towards the nearest habitable planet in the system. Some time later, your pod slams into this unknown rimworld.</description>
		<scenario>
			<summary>Three crashlanded expies - similar to Crashlanded, but peace with The Company™ is unobtainable.</summary>
			<playerFaction>
				<factionDef>CR_PlayerExpieColony</factionDef>
			</playerFaction>
			<parts>
				<!-- Config pages -->

				<li Class="CasualtiesRimknown.ScenParts.ScenPart_ConfigPage_ConfigureStartingPawns_KindDefs_Ext">
					<def>ConfigurePawnsKindDefs</def>
					<pawnChoiceCount>8</pawnChoiceCount>
					<leftBehindPawnKind>CR_ExpieColonist</leftBehindPawnKind>
					<kindCounts>
						<li>
							<kindDef>CR_ExpieColonist</kindDef>
							<count>3</count>
							<requiredAtStart>true</requiredAtStart>
						</li>
					</kindCounts>
				</li>

				<!-- Player starting stuff spawn method-->
				<li Class="ScenPart_PlayerPawnsArriveMethod">
					<def>PlayerPawnsArriveMethod</def>
				</li>

				<!-- Player pawns modifiers -->

				<!-- Player starting things -->
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Silver</thingDef>
					<count>800</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>MealSurvivalPack</thingDef>
					<count>50</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>MedicineHerbal</thingDef>
					<count>30</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>ComponentIndustrial</thingDef>
					<count>30</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Gun_BoltActionRifle</thingDef>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Gun_Revolver</thingDef>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>MeleeWeapon_Knife</thingDef>
					<stuff>Plasteel</stuff>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Apparel_FlakPants</thingDef>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Apparel_FlakVest</thingDef>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Apparel_AdvancedHelmet</thingDef>
					<stuff>Plasteel</stuff>
				</li>
				<!--
				<li Class="ScenPart_StartingAnimal">
					<def>StartingAnimal</def>
					<count>1</count>
					<bondToRandomPlayerPawnChance>1</bondToRandomPlayerPawnChance>
				</li>
				-->

				<!-- Scatter some things near player start -->
				<li Class="ScenPart_ScatterThingsNearPlayerStart">
					<def>ScatterThingsNearPlayerStart</def>
					<thingDef>Steel</thingDef>
					<count>450</count>
					<allowRoofed>True</allowRoofed>
				</li>
				<li Class="ScenPart_ScatterThingsNearPlayerStart">
					<def>ScatterThingsNearPlayerStart</def>
					<thingDef>WoodLog</thingDef>
					<count>300</count>
					<allowRoofed>True</allowRoofed>
				</li>

				<!-- Scatter some things anywhere -->
				<li Class="ScenPart_ScatterThingsAnywhere">
					<def>ScatterThingsAnywhere</def>
					<thingDef>ShipChunk</thingDef>
					<count>3</count>
				</li>
				<li Class="ScenPart_ScatterThingsAnywhere">
					<def>ScatterThingsAnywhere</def>
					<thingDef>Steel</thingDef>
					<count>720</count>
					<allowRoofed>True</allowRoofed>
				</li>
				<li Class="ScenPart_ScatterThingsAnywhere">
					<def>ScatterThingsAnywhere</def>
					<thingDef>MealSurvivalPack</thingDef>
					<count>7</count>
					<allowRoofed>True</allowRoofed>
				</li>

				<!-- Game start dialog -->
				<li Class="ScenPart_GameStartDialog">
					<def>GameStartDialog</def>
					<text>The pod wasn't anything too elegant, but you and your friends would take anything to get off this forsaken planet.\n\nThe pod didn't quite survive the landing, but you are alive. Now its time to turn this planet into a new home.</text>
					<closeSound>GameStartSting</closeSound>
				</li>
			</parts>
		</scenario>
	</ScenarioDef>

	<PawnKindDef ParentName="BasePlayerPawnKind">
		<defName>CR_ExpieColonist</defName>
		<label>colonist</label>
		<defaultFactionDef>CR_PlayerExpieColony</defaultFactionDef>
		<xenotypeSet>
			<xenotypeChances>
				<!-- Species: Experiment -->
				<ERN_Expie MayRequire="Erin.Expie">360</ERN_Expie>
				<Expie_Xenotype MayRequire="Expieworld.Package">360</Expie_Xenotype>
				<GX_Expie_Xenotype MayRequire="yourimaine.GunsawXenotypes">360</GX_Expie_Xenotype>
				<!-- Species: Milky -->
				<Milky_Xenotype MayRequire="Milkyworld.Package">128</Milky_Xenotype>
				<ERNLE_Milky MayRequire="kotovaann.ernloreexpansion">128</ERNLE_Milky>
				<GX_Milky_Xenotype MayRequire="yourimaine.GunsawXenotypes">128</GX_Milky_Xenotype>
				<!-- Species: Dune -->
				<ERNLE_Dune MayRequire="kotovaann.ernloreexpansion">8</ERNLE_Dune>
				<GX_Dune_Xenotype MayRequire="yourimaine.GunsawXenotypes">8</GX_Dune_Xenotype>
				<!-- Species: Roza -->
				<GX_Roza_Xenotype MayRequire="yourimaine.GunsawXenotypes">32</GX_Roza_Xenotype>
				<!-- Species: Orange -->
				<GX_Orange_Xenotype MayRequire="yourimaine.GunsawXenotypes">208</GX_Orange_Xenotype>
				<!-- Species: Shelly -->
				<GX_Shelly_Xenotype MayRequire="yourimaine.GunsawXenotypes">4</GX_Shelly_Xenotype>
				<!-- Species: Voyager -->
				<GX_Voyager_Xenotype MayRequire="yourimaine.GunsawXenotypes">16</GX_Voyager_Xenotype>
				<!-- Species: Leapy -->
				<GX_Leapy_Xenotype MayRequire="yourimaine.GunsawXenotypes">8</GX_Leapy_Xenotype>
				<!-- Species: Chompy -->
				<GX_Chompy_Xenotype MayRequire="yourimaine.GunsawXenotypes">24</GX_Chompy_Xenotype>
				<!-- Species: Baron -->
				<GX_Baron_Xenotype MayRequire="yourimaine.GunsawXenotypes">1</GX_Baron_Xenotype>
				<!-- Species: Velvet -->
				<GX_Velvet_Xenotype MayRequire="yourimaine.GunsawXenotypes">2</GX_Velvet_Xenotype>
				<!-- Species: Crystal -->
				<GX_Crystal_Xenotype MayRequire="yourimaine.GunsawXenotypes">8</GX_Crystal_Xenotype>
				<!-- Species: Chik -->
				<GX_Chik_Xenotype MayRequire="yourimaine.GunsawXenotypes">16</GX_Chik_Xenotype>
				<!-- Species: Icke -->
				<GX_Icke_Xenotype MayRequire="yourimaine.GunsawXenotypes">4</GX_Icke_Xenotype>
				<!-- Species: Experiment (Albino) -->
				<GX_Albino_Xenotype MayRequire="yourimaine.GunsawXenotypes">4</GX_Albino_Xenotype>
			</xenotypeChances>
		</xenotypeSet>
		<!--<useFactionXenotypes>false</useFactionXenotypes>-->
		<chemicalAddictionChance>0.06</chemicalAddictionChance>
		<apparelTags>
			<li>IndustrialBasic</li>
		</apparelTags>
		<apparelAllowHeadgearChance>0</apparelAllowHeadgearChance>
		<apparelMoney>350~600</apparelMoney>
		<backstoryCryptosleepCommonality>1</backstoryCryptosleepCommonality>
		<techHediffsChance>0.03</techHediffsChance>
		<techHediffsMoney>50~800</techHediffsMoney>
		<techHediffsTags>
			<li>Poor</li>
			<li>Simple</li>
			<li>ImplantEmpireCommon</li>
		</techHediffsTags>
		<techHediffsDisallowTags>
			<li>PainCauser</li>
		</techHediffsDisallowTags>
		<initialResistanceRange>13~21</initialResistanceRange>
	</PawnKindDef>
</Defs>